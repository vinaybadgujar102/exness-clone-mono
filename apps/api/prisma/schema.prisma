// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  magicTokens MagicToken[]
  pastTrades  PastTrades[]
}

model MagicToken {
  id          Int      @id @default(autoincrement())
  hashedToken String
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  used        Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

enum PrismaAssetSymbols {
  ETHUSDT
  BTCUSDT
}

enum OrderSide {
  BUY
  SELL
}

model PastTrades {
  id               Int                @id @default(autoincrement())
  asset            PrismaAssetSymbols
  side             OrderSide
  entryPrice       Int
  margin           Int
  leverage         Int
  notional         Int
  quantity         Int
  pnl              Int
  createdAt        DateTime
  liquidationPrice Int

  userId Int
  user   User @relation(fields: [userId], references: [id])
}

model Assets {
  id      Int                @id @default(autoincrement())
  symbol  PrismaAssetSymbols
  decimal Int
  spread  Int                @default(2)
}
